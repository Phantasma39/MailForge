# ---- 构建产物（make 生成，勿提交） ----
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.out
*.exe~
build/
Debug/
Release/
bin/
obj/
mail_server
mail_client_test
smtp_server
bridge

# 加密子系统自测/工具产物（make test-crypto / demo-crypto 生成）
crypto/tests/test_base64
crypto/tests/test_logger
crypto/tests/test_socket
crypto/tests/test_crypto
crypto/tests/demo_envelope
crypto/tests/demo_visual
crypto/tests/test_rsa_web
crypto/tools/crypto_cli

# ---- 运行时数据（启动服务器后自动生成） ----
mailbox/
keys/
sent/
data/
*.pem
*.eml

# ---- 日志 / Python ----
*.log
__pycache__/
*.pyc

# ---- IDE / 系统 ----
.vscode/
.idea/
*.suo
*.user
CMakeLists.txt.user
Thumbs.db
.DS_Store

# ---- 其他 ----
课程要求/
src/server
