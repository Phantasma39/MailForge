# ============================================================================
#  MailForge .gitignore
# ============================================================================

# ---- 构建产物（make 生成，勿提交） ----
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.out
*.exe~
build/
Debug/
Release/
bin/
obj/
mail_server
mail_client_test
smtp_server
bridge

# ---- 运行时数据（启动服务器后自动生成） ----
mailbox/
keys/
data/
*.pem
*.eml

# ---- 日志 / Python ----
*.log
__pycache__/
*.pyc

# ---- IDE / 系统 ----
.vscode/
.idea/
*.suo
*.user
CMakeLists.txt.user
Thumbs.db
.DS_Store

# ---- 其他 ----
课程要求/
src/server
